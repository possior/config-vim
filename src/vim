if filereadable(expand("builtin"))
    source builtin
else
endif

if filereadable(expand("options"))
    source options
else
    set expandtab
    set tabstop=4
endif

set cursorline
set nobackup
set nocompatible
set number
set wrap

set encoding=utf-8
set laststatus=2

filetype on
filetype plugin on
filetype indent on

syntax enable
